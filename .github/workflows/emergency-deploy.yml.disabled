on:
  workflow_dispatch: {}

# .github/workflows/emergency-deploy.yml
# 理쒖쥌蹂? WIF(???놁쓬) ?꾩슜 / Cloud Run ?뚯뒪 諛고룷 / ADMIN_TOKEN? Secret Manager濡?二쇱엯

name: Deploy to Cloud Run

on:
  workflow_dispatch:          # ?섎룞 ?ㅽ뻾
  push:
    branches: [ "main" ]      # main ?몄떆 ???먮룞
  pull_request:               # PR 泥댄겕??
permissions:
  contents: read
  id-token: write             # WIF(OIDC) ?ъ슜???꾩닔

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      # 0) ?뚯뒪 泥댄겕?꾩썐
      - name: Checkout
        uses: actions/checkout@v4

      # 1) WIF ?몄쬆 (JSON ???ъ슜 湲덉?)
      - name: Auth to Google Cloud (WIF)
        uses: google-github-actions/auth@v2
        with:
          project_id: ${{ secrets.GCP_PROJECT_ID }}
          workload_identity_provider: ${{ secrets.GOOGLE_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.GCP_DEPLOY_SA_EMAIL }}

      # 2) gcloud ?ㅼ튂
      - name: Set up Cloud SDK
        uses: google-github-actions/setup-gcloud@v2
        with:
          project_id: ${{ secrets.GCP_PROJECT_ID }}

      # 3) ?꾩슂??API 蹂댁옣
      - name: Enable required APIs
        shell: bash
        run: |
          gcloud services enable \
            run.googleapis.com \
            cloudbuild.googleapis.com \
            artifactregistry.googleapis.com \
            secretmanager.googleapis.com

      # 4) Cloud Run 諛고룷(?뚯뒪?먯꽌 鍮뚮뱶 ??諛고룷)
      #    - ?ㅽ뻾 SA 吏?? GOOGLE_SERVICE_ACCOUNT (?좏깮)
      #    - ADMIN_TOKEN: Secret Manager?먯꽌 理쒖떊 踰꾩쟾 ?곌껐
      #    - API_KEY: ?덉쑝硫??됰Ц ENV濡?二쇱엯
      - name: Deploy to Cloud Run
        shell: bash
        env:
          REGION: ${{ secrets.CLOUD_RUN_REGION }}
          SERVICE: ${{ secrets.CLOUD_RUN_SERVICE }}
          RUN_SA: ${{ secrets.GOOGLE_SERVICE_ACCOUNT }}     # ?? quali-run-sa@... (?놁쑝硫?鍮꾩썙??
          ADMIN_TOKEN_SECRET_NAME: ADMIN_TOKEN              # Secret Manager???쒗겕由??대쫫
          API_KEY: ${{ secrets.API_KEY }}                   # ?좏깮
        run: |
          set -euo pipefail

          SA_OPT=""
          if [[ -n "${RUN_SA:-}" ]]; then
            SA_OPT="--service-account ${RUN_SA}"
          fi

          # ?됰Ц ENV(?좏깮)
          ENV_OPTS=""
          if [[ -n "${API_KEY:-}" ]]; then
            ENV_OPTS="--update-env-vars API_KEY=${API_KEY}"
          fi

          # Secret Manager ??而⑦뀒?대꼫 ENV 留ㅽ븨
          SECRET_OPTS="--set-secrets ${ADMIN_TOKEN_SECRET_NAME}=${ADMIN_TOKEN_SECRET_NAME}:latest"

          # ?뚯뒪?먯꽌 鍮뚮뱶?섏뿬 諛고룷(Cloud Build ?ъ슜)
          gcloud run deploy "${SERVICE}" \
            --region "${REGION}" \
            --source . \
            ${SA_OPT} \
            ${ENV_OPTS} \
            ${SECRET_OPTS} \
            --allow-unauthenticated \
            --quiet

      # 5) ?쒕퉬??URL 異쒕젰
      - name: Show URL
        id: show-url
        shell: bash
        env:
          REGION: ${{ secrets.CLOUD_RUN_REGION }}
          SERVICE: ${{ secrets.CLOUD_RUN_SERVICE }}
        run: |
          URL=$(gcloud run services describe "${SERVICE}" --region "${REGION}" --format='value(status.url)')
          echo "Service URL: ${URL}"
          echo "url=${URL}" >> "$GITHUB_OUTPUT"

      # 6) ?ㅻえ???뚯뒪??200怨꾩뿴 湲곕?)
      - name: Smoke test (health & report)
        if: always()
        shell: bash
        env:
          URL: ${{ steps.show-url.outputs.url }}
          ADMIN_TOKEN: ${{ secrets.ADMIN_TOKEN }}
        run: |
          set -e
          echo "Ping: ${URL}/api/status"
          CODE=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: Bearer ${ADMIN_TOKEN}" "${URL}/api/status" || true)
          echo "HTTP ${CODE}"
          if [[ "${CODE}" =~ ^2 ]]; then
            echo "Smoke OK"
          else
            echo "::warning::Smoke test returned HTTP ${CODE}"
          fi


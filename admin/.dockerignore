##############################
# 기본 제외(빌드 컨텍스트 슬림화)
##############################
.git
.gitignore
**/__pycache__/
*.py[cod]
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
.env
.env.*
.venv/
venv/
node_modules/
*.sqlite*
*.db
*.ipynb_checkpoints/

##############################
# 프로젝트별 제외
##############################
archive/**
logs/**
exports/**
db_snapshots/**
dist/**

##############################
# ⛳ 반드시 포함해야 하는 Admin 정적 리소스
##############################
!admin/index.html
!admin/service-worker.js
!admin/**/*.html
!admin/**/*.js
!admin/**/*.css
!admin/**/*.map
!admin/**/*.png
!admin/**/*.jpg
!admin/**/*.svg
!admin/**/*.ico
!admin/**/*.webp
!admin/**/*.woff
!admin/**/*.woff2
!admin/dist/**

##############################
# 백엔드 필수 포함
##############################
!server_quali.py
!requirements*.txt
!pyproject.toml
!poetry.lock

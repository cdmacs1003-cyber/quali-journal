{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qlib:f13:schema:auto-suggestion:0.1",
  "title": "F13 Auto Suggestion Schema",
  "description": "Materialized ICD-G2 schema for rule, dictionary, or human-generated candidate suggestions that still require human approval.",
  "type": "object",
  "required": [
    "suggestion_id",
    "candidate_id",
    "generated_by",
    "generated_at",
    "model_or_rule_version",
    "doc_kind_candidates",
    "tag_candidates",
    "relation_candidates",
    "evidence_candidates",
    "overlay_candidates",
    "risk_flags",
    "confidence_overall",
    "requires_human_approval"
  ],
  "properties": {
    "suggestion_id": {
      "type": "string",
      "pattern": "^suggestion:[A-Za-z0-9._:-]+$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate:[A-Za-z0-9._:-]+$"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "RULE",
        "DICTIONARY",
        "HUMAN"
      ],
      "description": "F13 bounded generator source."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_or_rule_version": {
      "type": "string",
      "minLength": 1
    },
    "doc_kind_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "confidence",
          "reason"
        ],
        "properties": {
          "value": {
            "type": "string",
            "enum": [
              "STANDARD",
              "REFERENCE",
              "WAREHOUSE_ITEM",
              "FEEDBACK",
              "FIELD_CASE",
              "QA_CASE",
              "TRAINING_MATERIAL",
              "OVERLAY_RULE",
              "TERM_REGISTRY",
              "RELATION_RECORD"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tag_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag_id",
          "label",
          "confidence",
          "source"
        ],
        "properties": {
          "tag_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "RULE",
              "DICTIONARY",
              "HUMAN"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "relation_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation_type",
          "target_id",
          "target_label",
          "confidence",
          "evidence_span"
        ],
        "properties": {
          "relation_type": {
            "type": "string",
            "enum": [
              "supports",
              "refines",
              "conflicts_with",
              "derives_from",
              "applies_to",
              "related_to"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_span": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_span",
          "evidence_required",
          "confidence"
        ],
        "properties": {
          "evidence_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^evidence:[A-Za-z0-9._:-]+$"
          },
          "source_span": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "overlay_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "overlay_id",
          "applicability",
          "rationale_candidate",
          "confidence"
        ],
        "properties": {
          "overlay_id": {
            "type": "string",
            "pattern": "^overlay:[A-Za-z0-9._:-]+$"
          },
          "applicability": {
            "type": "string",
            "enum": [
              "APPLIES",
              "DOES_NOT_APPLY",
              "PARTIALLY_APPLIES",
              "TAILORED",
              "UNKNOWN"
            ]
          },
          "rationale_candidate": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "RIGHTS_UNKNOWN",
          "RAW_TEXT_RISK",
          "MISSING_EVIDENCE",
          "LOW_CONFIDENCE",
          "NEEDS_DOMAIN_REVIEW",
          "NEEDS_RIGHTS_REVIEW",
          "BRIDGE_HOLD_RISK"
        ]
      },
      "uniqueItems": true
    },
    "confidence_overall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human_approval": {
      "const": true
    }
  },
  "additionalProperties": false
}

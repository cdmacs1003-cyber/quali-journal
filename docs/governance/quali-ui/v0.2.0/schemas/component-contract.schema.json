{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quali.local/schemas/component-contract.schema.json",
  "title": "Quali UI Component Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "purpose", "required_props", "accessibility"],
  "properties": {
    "id": { "type": "string", "pattern": "^QCMP-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "required_props": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "states": {
      "type": "array",
      "items": { "$ref": "status.schema.json" }
    },
    "accessibility": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

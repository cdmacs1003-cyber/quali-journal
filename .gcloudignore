# === 기본 제외(용량/보안) ===
.git/
.github/
.gcloudignore
.gitignore
*.log

# Python 캐시/가상환경
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Node/프론트
node_modules/

# 아카이브/임시
*.zip
*.tar
*.tar.gz
*.tmp

# === 매우 중요: HTML 포함 예외 규칙 ===
!index.html
!**/*.html
!**/*.htm

# (UI가 admin 폴더에 있다면 안전망 한 번 더)
!admin/index.html
!admin/**/*.html

# 서버/필수 파일은 포함 보장(실수 방지)
!requirements.txt
!server_quali.py
!admin/server_quali.py
!app/**
!static/**
